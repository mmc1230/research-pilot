[Unit]
Description=ResearchPilot FastAPI Backend
After=network.target

[Service]
Type=simple
User=researchpilot
Group=researchpilot
WorkingDirectory=/opt/research_pilot
EnvironmentFile=/opt/research_pilot/.env
ExecStart=/opt/research_pilot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
