# DeepSeek can be used as an OpenAI-compatible chat model.
# Do not use deepseek-v4-pro as an embedding model.
# When EMBEDDING_PROVIDER=fake, ResearchPilot does not call any embedding API.
# When EMBEDDING_PROVIDER=openai, ResearchPilot calls OpenAIEmbeddings and reads OPENAI_EMBEDDING_MODEL.
# Future extension: EMBEDDING_PROVIDER=local_bge for BAAI/bge-small-zh-v1.5, BAAI/bge-m3, etc.

EMBEDDING_PROVIDER=fake

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VECTOR_STORE_PROVIDER=chroma
UPLOAD_DIR=/opt/research_pilot/data/uploads
VECTOR_DB_DIR=/opt/research_pilot/data/vector_db
PROJECTS_DIR=/opt/research_pilot/data/projects
DATABASE_URL=sqlite:////opt/research_pilot/data/researchpilot.db
LOG_LEVEL=INFO
